{
  "name": "spendwise",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Serverless expense tracker API: AWS Lambda, API Gateway (HTTP API), DynamoDB and S3, defined with AWS SAM.",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1155.0",
    "@aws-sdk/client-s3": "^3.1155.0",
    "@aws-sdk/lib-dynamodb": "^3.1155.0",
    "@aws-sdk/s3-presigned-post": "^3.1155.0",
    "@aws-sdk/s3-request-presigner": "^3.1155.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "dynalite": "^4.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
  }
}
